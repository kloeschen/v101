---
/**
 * Liste von Registry-Einträgen. Wird für Rückverweise verwendet: Auftritte
 * einer Band, Inhalte einer Region, Verwandtes im Fußbereich — und über das
 * ListenLayout für sämtliche Übersichts- und Facettenseiten.
 *
 * Diese Listen werden abgeleitet, nicht gepflegt — deshalb sind sie
 * automatisch vollständig und laufen nie auseinander.
 *
 * Der Entwurfshinweis steht hier und nicht in den Aufrufern: Diese
 * Komponente ist die einzige Stelle, an der ein Eintrag in einer Liste
 * gerendert wird. Solange das so bleibt, kann kein Entwurf irgendwo
 * unmarkiert auftauchen. Das Entitätslayout hat seinen eigenen, größeren
 * Hinweis — dort steht der Entwurf allein, hier zwischen fertigen Einträgen,
 * und genau da ist die Verwechslungsgefahr am größten.
 */
import type { EintragMeta } from "../lib/links";
import { istEntwurf } from "../lib/sichtbarkeit";

/**
 * `knapp` schaltet die Kurzbeschreibungen ab.
 *
 * Auf Übersichts- und Facettenseiten sind sie der Inhalt: Dort sucht jemand
 * und entscheidet anhand des Satzes, ob er klickt. Im Fußbereich einer
 * Entitätsseite sind sie es nicht — dort steht das Verwandte neben einem
 * Text, der dieselben Begriffe oft schon erklärt hat, und aus zwölf
 * Einträgen wird eine zweite Seite. Ein Parameter statt einer zweiten
 * Komponente, damit die Entwurfsmarke an genau einer Stelle bleibt.
 */
interface Props { titel: string; eintraege: EintragMeta[]; ebene?: 2 | 3; knapp?: boolean }
const { titel, eintraege, ebene = 2, knapp = false } = Astro.props;
const Ueberschrift = `h${ebene}` as "h2" | "h3";
---
{eintraege.length > 0 && (
  <section class={knapp ? "liste liste--knapp" : "liste"}>
    <Ueberschrift>{titel}</Ueberschrift>
    <ul>
      {eintraege.map((e) => (
        <li>
          <a href={e.pfad}>{e.name}</a>
          {istEntwurf(e.daten) && (
            <span class="liste__entwurf" title="Noch nicht redaktionell freigegeben"> [Entwurf]</span>
          )}
          {!knapp && e.kurzbeschreibung && <span class="liste__beschreibung"> — {e.kurzbeschreibung}</span>}
        </li>
      ))}
    </ul>
  </section>
)}
