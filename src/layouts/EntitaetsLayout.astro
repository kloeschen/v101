---
/**
 * Das universelle Seitengerüst für alle sechs Entitätstypen.
 *
 * Die Reihenfolge ist nicht Geschmackssache, sondern die Extraktionsfläche.
 * Wer sie ändert, ändert, was ein Modell aus den ersten Tokens der Seite
 * mitnimmt:
 *
 *   H1 → Faktenblock → Inhalt → FAQ → Rückverweise → Belege
 *
 * DIE ANTWORTKAPSEL HAT KEIN EIGENES ELEMENT. Sie ist der erste Absatz des
 * Fließtexts, also `.inhalt > p:first-child` — genau das prüft die Regel
 * `kapsel-vorhanden` (25–90 Wörter). Gestalterisch ist sie nur über diesen
 * Selektor erreichbar; die Klasse `.kapsel` gibt es ausschließlich auf
 * Übersichts-, Facetten- und Startseite.
 *
 * Bis zum 2026-09-16 behauptete dieser Kommentar die Reihenfolge „H1 →
 * Antwortkapsel → Faktenblock → Inhalt". Das hat der Code nie getan, und
 * DESIGN-BRIEF.md hat den Fehler jahrelang weitergetragen. Die Entscheidung
 * vom 16.09.2026 lautet: Der Code bleibt, der Kommentar wird richtig.
 *
 * Der Grund, warum der Faktenblock vorn steht und dort auch hingehört: Er
 * ist der dichteste strukturierte Inhalt der Seite. Wer wissen will, wann
 * das Festival ist, findet es ohne Scrollen — und ein extrahierendes Modell
 * bekommt zuerst dt/dd-Paare statt Prosa. Die Alternativen sind in
 * ENTSCHEIDUNGEN.md samt ihrer gemessenen Kosten festgehalten.
 */
import BasisLayout from "./BasisLayout.astro";
import { vorschauPfad } from "../lib/vorschaubild";
import Faktenblock from "../components/Faktenblock.astro";
import FaqBlock from "../components/FaqBlock.astro";
import Quellen from "../components/Quellen.astro";
import EintragsListe from "../components/EintragsListe.astro";
import { buildGraph } from "../lib/jsonld";
import { verwandtes, type Registry } from "../lib/links";
import { SAMMLUNGSNAME, sammlungsPfad } from "../lib/faktenblock";
import type { CollectionName } from "../content/_schemas";
import { meldePfad } from "../lib/vorschlag";

interface Props {
  collection: CollectionName;
  slug: string;
  daten: Record<string, any>;
  registry: Registry;
  /** Zusätzliche abgeleitete Listen, je nach Entitätstyp. */
  listen?: { titel: string; eintraege: any[] }[];
  /**
   * Vom Aufrufer errechnetes `noindex` — zusätzlich zu Entwurfsstatus und
   * manuellem Override, nie an deren Stelle. Die Regionsschwelle setzt es.
   */
  noindex?: boolean;
  /** Wird nur in der Entwicklung angezeigt — wie im Listenlayout. */
  indexGrund?: string;
}
const { collection, slug, daten, registry, listen = [], noindex = false, indexGrund } = Astro.props;

const graph = buildGraph(collection, slug, daten);
const pfad = `${sammlungsPfad(collection)}${slug}/`;
const verwandt = verwandtes(registry, collection, slug);
const entwurf = daten.status !== "veroeffentlicht";
---
<BasisLayout
  titel={daten.name}
  beschreibung={daten.kurzbeschreibung}
  kanonisch={pfad}
  noindex={entwurf || daten.noindex || noindex}
  jsonld={graph}
  vorschaubild={vorschauPfad(collection, slug)}
>
  <nav aria-label="Brotkrumen">
    <a href="/">Start</a> ›
    <a href={sammlungsPfad(collection)}>{SAMMLUNGSNAME[collection]}</a> ›
    <span aria-current="page">{daten.name}</span>
  </nav>

  <article>
    <h1>{daten.name}</h1>
    {entwurf && <p class="hinweis"><strong>Entwurf</strong> — noch nicht redaktionell freigegeben.</p>}
    {indexGrund && import.meta.env.DEV && (
      <p class="hinweis"><strong>noindex</strong> — {indexGrund}</p>
    )}

    <Faktenblock collection={collection} daten={daten} registry={registry} />

    <div class="inhalt"><slot /></div>

    <FaqBlock faq={daten.faq ?? []} />

    {listen.map((l) => <EintragsListe titel={l.titel} eintraege={l.eintraege} />)}

    {/* Der Entitätsname gehört auch in die vom Layout erzeugten
        Überschriften: Ein Abschnitt kann isoliert extrahiert werden, und
        "Verwandtes" allein trägt dann keine Zuordnung mehr. */}
    <EintragsListe titel={`Verwandt mit ${daten.name}`} eintraege={verwandt} knapp />

    <Quellen quellen={daten.quellen ?? []} geprueftAm={daten.geprueftAm} autor={daten.autor} />
    {/* Korrekturen laufen über dasselbe Formular wie Vorschläge; der
        Eintrag ist vorbelegt, damit die Meldung zuordenbar ist. */}
    <p class="melden"><a href={meldePfad(collection, slug)}>Fehler melden oder etwas ergänzen</a></p>
  </article>
</BasisLayout>
