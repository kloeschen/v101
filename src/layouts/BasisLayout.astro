---
/**
 * HTML-Rahmen. Bewusst minimal — hier gehört Design hin, keine Logik.
 * Wichtig ist nur, dass der Textinhalt früh im DOM steht: Navigation und
 * Deko kommen nach <main>, nicht davor.
 */
import { site, indexierbar } from "../site.config";
// Reihenfolge zählt: erst der Token-Vertrag, dann die Gestaltung, die ihn
// benutzt. Eine neue Gestaltung tauscht basis.css und ergänzt tokens.css —
// das Markup bleibt unangetastet.
import "../styles/tokens.css";
import "../styles/basis.css";
import { jsonldSicher } from "../lib/jsonld";
import { holeRegistry } from "../lib/registry";
import { collectionNames, type CollectionName } from "../content/_schemas";
import { SAMMLUNGSNAME, sammlungsPfad } from "../lib/faktenblock";

interface Props {
  titel: string;
  beschreibung: string;
  kanonisch: string;
  noindex?: boolean;
  jsonld?: unknown;
}
const { titel, beschreibung, kanonisch, noindex = false, jsonld } = Astro.props;

// Der globale Schalter sticht jede Einzelentscheidung: Solange die Site
// nicht freigegeben ist, wird nichts indexiert.
const nichtIndexieren = noindex || !indexierbar;

/**
 * Die Navigation führt nur auf Sammlungen, die etwas enthalten.
 *
 * Vorher war sie eine feste Liste — und zeigte auf `/bands/`, wo „Das
 * Register enthält 0 Einträge" stand, während `/locations/` mit sieben
 * echten Einträgen gar nicht auftauchte. Abgeleitet statt gepflegt heißt:
 * Die Navigation kann nicht mehr auseinanderlaufen, weder in die eine noch
 * in die andere Richtung.
 *
 * Gezählt wird aus `holeRegistry`, also aus dem, was der Besucher auf dieser
 * Seite sieht — in der Vorschau mit Entwürfen, in der Produktion ohne.
 */
const registry = await holeRegistry();
const sammlungen = collectionNames.filter((typ: CollectionName) =>
  [...registry.eintraege.values()].some((e) => e.collection === typ),
);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel} — {site.name}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={`${site.url}${kanonisch}`} />
    {nichtIndexieren && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={`${site.url}${kanonisch}`} />
    <meta property="og:type" content="website" />
    {/* is:inline ist hier richtig: Der Graph soll unverarbeitet im HTML stehen,
        nicht durch Astros Skript-Pipeline laufen. */}
    {jsonld && <script is:inline type="application/ld+json" set:html={jsonldSicher(jsonld)} />}
  </head>
  <body>
    <main><slot /></main>
    <nav aria-label="Hauptnavigation">
      <a href="/">Start</a>
      {sammlungen.map((typ) => <a href={sammlungsPfad(typ)}>{SAMMLUNGSNAME[typ]}</a>)}
    </nav>
  </body>
</html>
